# Shiftable environment variables
# Copy this file to .env and fill in the values.
# Generated automatically by install.sh for fresh installs.

# REQUIRED — the restaurant's local timezone, as an IANA name
# (America/New_York, Europe/London, Australia/Sydney …).
# Shiftable resolves "today" and "this week" in the server's local time. If this
# does not match the restaurant, those roll over at the wrong moment: after
# roughly 7pm in the Americas the app treats tomorrow as today, showing staff the
# wrong week and rejecting same-day time-off requests. There is no in-app setting
# for this — it is set at install and lives here.
# List options with: timedatectl list-timezones
TZ=UTC

# Which day the schedule week starts on: monday (default) or sunday.
# Set at install time and never afterwards. Schedules, availability patterns and
# week events are all keyed to week-start dates, and every day_of_week value is an
# offset from this day, so changing it once data exists reinterprets every stored
# week. There is deliberately no in-app setting for it.
WEEK_START=monday

# REQUIRED — generate with: openssl rand -hex 64
JWT_SECRET=

# REQUIRED — generated automatically by install.sh
# IMPORTANT: VAPID_PRIVATE_KEY must NEVER be stored in the database or exposed via API
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# OPTIONAL — email settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# INTERNAL — set by install.sh, do not change manually
# DB_PATH defaults to /opt/shiftable-<slug>/data/shiftable.db in production
DB_PATH=

# Server
PORT=3000
NODE_ENV=production
